{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build - Debug",
            "type": "shell",
            "command": "make",
            "problemMatcher": "$gcc",
            "options": {
                "cwd": "${workspaceFolder}/build/Debug"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "clear": true
            }
        },
        {
            "label": "Build - Release",
            "type": "shell",
            "command": "make",
            "problemMatcher": "$gcc",
            "options": {
                "cwd": "${workspaceFolder}/build/Release",
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },"presentation": {
                "clear": true
            }
        },
        {
            "label": "CMake - Debug",
            "type": "shell",
            "command": "cmake -DCMAKE_BUILD_TYPE=Debug ../.. -G 'Unix Makefiles'",
            "options": {
                "cwd": "${workspaceFolder}/build/Debug",
                "env": { "CMAKE_BUILD_TYPE": "Debug" }
            },
            "problemMatcher": [],
            "presentation": {
                "clear": true
            }
        },
        {
            "label": "CMake - Release",
            "type": "shell",
            "command": "cmake -DCMAKE_BUILD_TYPE=Release ../.. -G 'Unix Makefiles'",
            "options": {
                "cwd": "${workspaceFolder}/build/Release",
                "env": { "CMAKE_BUILD_TYPE": "Release" }
            },
            "problemMatcher": [],
            "presentation": {
                "clear": true
            }
        }
    ]
}
